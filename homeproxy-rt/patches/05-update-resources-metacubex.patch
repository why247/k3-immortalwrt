+# Refresh firewall rules if CN IPs were updated (nftables embeds the CIDRs).
+# The generated include is syntax-checked with nft --check before reloading.
+# Note: --check is a userspace dry-run and cannot detect kernel-side EEXIST
+# errors from duplicate set elements; duplicates are eliminated earlier by
+# load_cidr_file()'s normalized dedup in firewall_pre.uc. A broken include
+# aborts the entire fw4 reload and would leave the firewall (and the
+# transparent proxy) down, as happened with a duplicate-laden upstream list.
+# On any failure the previous working include AND the previous data files
+# are restored, so the daemon never sees a half-applied update and won't
+# trigger a bad service reload.
+case "$UPDATED_BRANCHES" in
+	*cn_ip*)
+		log "[RESOURCES] cn_ip updated, refreshing firewall rules."
+		client_nft="$RUN_DIR/fw4_client.nft"
+		client_nft_bak="$RUN_DIR/fw4_client.nft.bak"
+		[ -f "$client_nft" ] && { cp -f "$client_nft" "$client_nft_bak" || log "[RESOURCES] WARN: failed to backup fw4_client.nft (disk full?)"; }
+		if ucode "/etc/homeproxy/scripts/firewall_pre.uc" 2>&1 | tee -a "$LOG_PATH" &&
+		   fw4 print 2>&1 | tee -a "$LOG_PATH" | nft --check -f - 2>&1 | tee -a "$LOG_PATH" &&
+		   fw4 reload 2>&1 | tee -a "$LOG_PATH"; then
+			log "[RESOURCES] Firewall reloaded."
+			# Commit the deferred cn_ip .ver now that firewall is in sync.
+			if [ -n "$DEFERRED_CN_IP_VER" ] && [ -f "$DEFERRED_CN_IP_VER" ]; then
+				mv -f "$DEFERRED_CN_IP_VER" "$cn_ip_ver" && log "[RESOURCES] cn_ip version committed."
+			fi
+			rm -f "$client_nft_bak" "$cn_ip_list_bak" "$cn_ip_ver_bak"
+		else
+			log "[RESOURCES] Firewall update failed; restoring previous rules and data."
+			[ -f "$cn_ip_list_bak" ] && cp -f "$cn_ip_list_bak" "$cn_ip_list"
+			[ -f "$cn_ip_ver_bak" ] && cp -f "$cn_ip_ver_bak" "$cn_ip_ver"
+			if [ -f "$client_nft_bak" ]; then
+				cp -f "$client_nft_bak" "$client_nft"
+				if fw4 reload >/dev/null 2>&1; then
+					log "[RESOURCES] Previous firewall rules restored."
+				else
+					log "[RESOURCES] CRITICAL: failed to restore firewall rules."
+					rm -f "$client_nft_bak" "$cn_ip_list_bak" "$cn_ip_ver_bak"
+					finish 2
+				fi
+				rm -f "$client_nft_bak" "$cn_ip_list_bak" "$cn_ip_ver_bak"
+			fi
+		fi
+		;;
+esac
