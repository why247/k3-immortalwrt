#!/bin/sh
# K3 性能：只做“首次启动写 UCI”，运行期调优交给 /etc/init.d 和 hotplug

# 1) fw4 软件流卸载：已建立的直连(国内)流量跳过整条 netfilter 路径，CPU 占用大降
#    与 HomeProxy 的 redirect/TPROXY 不冲突：被代理的流量走本机 input，不经过 forward，不会被卸载
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall

# 2) 网络：packet steering 把软中断分到两个核（替代以前手写 RPS，避免互相覆盖）
uci -q set network.globals=globals
uci -q set network.globals.packet_steering='1'
uci -q set network.lan.ipaddr='192.168.2.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q commit network

# 3) 日志放内存
uci -q set system.@system[0].log_size='64'
uci -q delete system.@system[0].log_file
uci -q set system.@system[0].zram_size_mb='128'
uci -q commit system

# 4) dnsmasq：fakeip 需要关 rebind 保护
uci -q set dhcp.@dnsmasq[0].rebind_protection='0'
uci -q commit dhcp

/etc/init.d/ppp disable 2>/dev/null
/etc/init.d/k3-tune enable 2>/dev/null
exit 0
