--- a/root/etc/uci-defaults/luci-homeproxy
+++ b/root/etc/uci-defaults/luci-homeproxy
@@ -19,6 +19,12 @@
 	set firewall.homeproxy_input.position="chain-pre"
 	set firewall.homeproxy_input.chain="input"
 
+	delete firewall.homeproxy_client
+	set firewall.homeproxy_client=include
+	set firewall.homeproxy_client.type=nftables
+	set firewall.homeproxy_client.path="/var/run/homeproxy/fw4_client.nft"
+	set firewall.homeproxy_client.position="table-post"
+
 	delete firewall.homeproxy_post
 	commit firewall
 EOF
@@ -33,4 +39,21 @@
 [ ! -f /var/run/homeproxy/sing-box-c.json ] || \
 	/etc/init.d/homeproxy restart >/dev/null 2>&1 || \
 	printf '%s\n' 'HomeProxy: failed to restart the running service after upgrade.' >&2
+# First boot: pre-download cn_ip.list so CN bypass works immediately.
+# Without this, hp_cn4 is empty until the first scheduled update (hours).
+# Retry in background, network may not be up yet on first boot.
+(
+	for i in 1 2 3 4 5 6; do
+		if [ ! -s /etc/homeproxy/resources/cn_ip.list ]; then
+			curl -fsSL --connect-timeout 10 --retry 2 \
+				"https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/cn.list" \
+				-o /etc/homeproxy/resources/cn_ip.list.tmp 2>/dev/null && \
+			[ $(wc -l < /etc/homeproxy/resources/cn_ip.list.tmp 2>/dev/null) -gt 8000 ] && \
+			mv /etc/homeproxy/resources/cn_ip.list.tmp /etc/homeproxy/resources/cn_ip.list && \
+			/etc/init.d/homeproxy reload >/dev/null 2>&1 && break
+		fi
+		sleep 30
+	done
+) &
+
 exit 0
