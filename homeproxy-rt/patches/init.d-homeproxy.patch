--- a/root/etc/init.d/homeproxy
+++ b/root/etc/init.d/homeproxy
@@ -35,9 +35,42 @@
 
 clear_firewall() {
 	: > "$RUN_DIR/fw4_input.nft"
+	: > "$RUN_DIR/fw4_client.nft"
 	fw4 reload >"/dev/null" 2>&1
 }
 
+# Policy routing for UDP TPROXY: packets marked by the hp_tproxy_out
+# nftables chain are routed locally into the sing-box TPROXY socket.
+# Table 100 is private to HomeProxy.
+setup_tproxy_routes() {
+	local tproxy_mark ipv6_support table=100
+
+	config_get tproxy_mark "infra" "tproxy_mark" "101"
+	config_get ipv6_support "config" "ipv6_support" "0"
+
+	# Drop stale rules first so repeated starts stay idempotent.
+	while ip rule del fwmark "$tproxy_mark" table "$table" 2>/dev/null; do :; done
+	ip rule add fwmark "$tproxy_mark" table "$table" 2>/dev/null || return 1
+	ip route replace local 0.0.0.0/0 dev lo table "$table" 2>/dev/null || return 1
+	if [ "$ipv6_support" = "1" ]; then
+		while ip -6 rule del fwmark "$tproxy_mark" table "$table" 2>/dev/null; do :; done
+		ip -6 rule add fwmark "$tproxy_mark" table "$table" 2>/dev/null || return 1
+		ip -6 route replace local ::/0 dev lo table "$table" 2>/dev/null || return 1
+	fi
+}
+
+clear_tproxy_routes() {
+	local tproxy_mark table=100
+
+	tproxy_mark="$(uci -q get homeproxy.infra.tproxy_mark 2>/dev/null)"
+	case "$tproxy_mark" in ''|*[!0-9]*) tproxy_mark=101 ;; esac
+
+	while ip rule del fwmark "$tproxy_mark" table "$table" 2>/dev/null; do :; done
+	while ip -6 rule del fwmark "$tproxy_mark" table "$table" 2>/dev/null; do :; done
+	ip route flush table "$table" 2>/dev/null
+	ip -6 route flush table "$table" 2>/dev/null
+}
+
 clear_dnsmasq() {
 	if [ -e "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf" ] || [ -d "$DNSMASQ_DIR" ]; then
 		rm -rf "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf" "$DNSMASQ_DIR"
@@ -177,7 +210,7 @@
 	local client_ready="$1"
 	local auto_update auto_update_time enabled=0
 
-	config_get_bool auto_update "subscription" "auto_update" "0"
+	config_get_bool auto_update "subscription" "auto_update" "1"
 	config_get auto_update_time "subscription" "auto_update_time" "0 */6 * * *"
 	if [ "$client_ready" -eq 1 ] && [ "$auto_update" -eq 1 ]; then
 		enabled=1
@@ -275,9 +308,10 @@
 		chown -R sing-box:sing-box "$CACHE_DIR"
 	fi
 
-	# Prepare firewall before sing-box inserts native TUN auto-redirect rules.
+	# Prepare firewall includes (server accept rules + client
+	# transparent-proxy rules) before sing-box starts.
 	local firewall_ready=1
-	if ! HOMEPROXY_SERVER_READY="$server_ready" \
+	if ! HOMEPROXY_SERVER_READY="$server_ready" HOMEPROXY_CLIENT_READY="$client_ready" \
 		ucode "$HP_DIR/scripts/firewall_pre.uc" 2>>"$LOG_PATH"; then
 		log "Error: failed to prepare firewall includes."
 		clear_firewall
@@ -292,6 +326,11 @@
 		client_ready=0
 		rm -f "$RUN_DIR/sing-box-c.json"
 	fi
+	if [ "$firewall_ready" -eq 1 ] && [ "$client_ready" -eq 1 ]; then
+		if ! setup_tproxy_routes; then
+			log "Error: failed to configure TPROXY policy routing; UDP proxying may not work."
+		fi
+	fi
 	if [ "$client_ready" -eq 1 ]; then
 		# DNSMasq rules
 		local dns_port dns_ready=1
@@ -322,15 +361,22 @@
 		# sing-box (client)
 		procd_open_instance "sing-box-c"
 
-		procd_set_param command "$PROG"
-		procd_append_param command run --config "$RUN_DIR/sing-box-c.json"
+		# OOM protection: sing-box is critical infrastructure, protect it from
+		# the OOM killer. -300 (not -1000, which would never be killed and
+		# could hang the system). Wrapper via /bin/sh -c, exec preserves it
+		# across respawns. (procd has no native oom_score_adj support)
+		procd_set_param command /bin/sh -c 'echo -300 > /proc/self/oom_score_adj; exec "$0" "$@"'
+		procd_append_param command "$PROG" run --config "$RUN_DIR/sing-box-c.json"
+		# N1 has 4 cores to spare, prioritize the proxy. K3 keeps 0 (dual-core
+		# is tight, negative nice could starve ksoftirqd and drop packets).
+		procd_set_param nice -5
 
 		# QUIC-GO GSO is broken on kernel 6.6 currently
 		uname -r | grep -Eq "^6\.6" && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"
-		# The client always creates a TUN inbound with auto_route and
-		# auto_redirect, so it cannot run inside the ujail setup used for the
-		# server instance below: the jail would need /dev/net/tun plus the
-		# netlink access sing-box uses to install its nftables redirect rules.
+		# The client uses redirect + TPROXY inbounds and manages its own
+		# nftables rules, so it cannot run inside the ujail setup used for the
+		# server instance below: the jail would block the netlink access
+		# sing-box needs to install them.
 		# The client is therefore started outside a jail by design.
 
 		procd_set_param limits core="unlimited"
@@ -424,6 +470,7 @@
 	config_load "$CONF"
 	sync_subscription_cron 0 || log "Error: failed to clear the subscription update schedule."
 	clear_firewall
+	clear_tproxy_routes
 
 	# Remove DNS hijack
 	clear_dnsmasq
