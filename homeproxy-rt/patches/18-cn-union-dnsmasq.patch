+# A domain list must be a real list, not an error page or a truncated file.
+validate_domain_list() {
+	[ "$(grep -c '^[+.a-z0-9]' "$1" 2>/dev/null)" -ge 50000 ]
+}
+
+# Merge both domain lists into one sing-box source and compile it here.
+# "+.x"/".x" (MetaCubeX) and plain felix lines are suffixes; other MetaCubeX
+# lines are exact domains. The hash covers both inputs, so the .srs is only
+# rebuilt (and sing-box only hot-reloads it) when either list changes.
+update_geosite_cn() {
+	local new_hash old_hash
+
+	if ! download "$GEOSITE_SOURCE" "$TMP_DIR/geosite_cn.list" ||
+	   ! download "$CHINA_LIST_SOURCE" "$TMP_DIR/china_list.txt"; then
+		log "[geosite_cn] Update failed while downloading."
+		return 1
+	fi
+	if ! validate_domain_list "$TMP_DIR/geosite_cn.list" ||
+	   ! validate_domain_list "$TMP_DIR/china_list.txt"; then
+		log "[geosite_cn] Update failed: downloaded list did not pass validation."
+		return 1
+	fi
+	new_hash="$(cat "$TMP_DIR/geosite_cn.list" "$TMP_DIR/china_list.txt" | sha256sum | awk '{print $1}')"
+	old_hash="$(cat "$RESOURCES_DIR/geosite_cn.ver" 2>/dev/null)"
+	if [ -n "$new_hash" ] && [ "$new_hash" = "$old_hash" ] && [ -s "$RESOURCES_DIR/geosite_cn.srs" ]; then
+		log "[geosite_cn] Already up to date ($(printf '%s' "$new_hash" | cut -c1-12))."
+		return 0
+	fi
+	if ! awk '
+		FNR == 1 { f++ }
+		/^[[:space:]]*(#|$)/ { next }
+		{
+			d = tolower($1); sub(/\r$/, "", d)
+			if (substr(d, 1, 2) == "+.") { d = substr(d, 3); sfx = 1 }
+			else if (substr(d, 1, 1) == ".") { d = substr(d, 2); sfx = 1 }
+			else sfx = (f == 2)
+			if (d !~ /^[a-z0-9._-]+$/) next
+			if (sfx) s[d] = 1; else full[d] = 1
+		}
+		END {
+			printf "{\"version\":2,\"rules\":[{\"domain_suffix\":["
+			n = 0; for (d in s) printf "%s\"%s\"", (n++ ? "," : ""), d
+			printf "],\"domain\":["
+			m = 0; for (d in full) if (!(d in s)) printf "%s\"%s\"", (m++ ? "," : ""), d
+			printf "]}]}\n"
+			exit (n < 50000)
+		}
+	' "$TMP_DIR/geosite_cn.list" "$TMP_DIR/china_list.txt" > "$TMP_DIR/geosite_cn.json" ||
+	   ! "$SING_BOX" rule-set compile -o "$TMP_DIR/geosite_cn.srs" "$TMP_DIR/geosite_cn.json" >>"$LOG_PATH" 2>&1 ||
+	   ! validate_rule_set "$TMP_DIR/geosite_cn.srs"; then
+		log "[geosite_cn] Update failed while building the merged rule-set."
+		return 1
+	fi
+	log "[geosite_cn] Local version: ${old_hash:-NOT FOUND}, latest version: $(printf '%s' "$new_hash" | cut -c1-12) (MetaCubeX cn + felix china-list)."
+	if ! install_resource "$TMP_DIR/geosite_cn.srs" "$new_hash" "geosite_cn" "srs"; then
+		log "[geosite_cn] Update failed while installing."
+		return 1
+	fi
+	log "[geosite_cn] Successfully updated."
+}
+
+# geoip-cn rule-set for the DNS probe, compiled from the same cn_ip.list the
+# nftables bypass uses, so DNS and firewall never disagree about "mainland".
+update_geoip_cn() {
+	local src="$TMP_DIR/cn_ip.list" new_hash old_hash
+	[ -s "$src" ] || src="$RESOURCES_DIR/cn_ip.list"
+	validate_cidr_list "$src" || { log "[geoip_cn] No valid cn_ip.list to build from."; return 1; }
+	new_hash="$(file_hash "$src")"
+	old_hash="$(cat "$RESOURCES_DIR/geoip_cn.ver" 2>/dev/null)"
+	if [ "$new_hash" = "$old_hash" ] && [ -s "$RESOURCES_DIR/geoip_cn.srs" ]; then
+		log "[geoip_cn] Already up to date ($(printf '%s' "$new_hash" | cut -c1-12))."
+		return 0
+	fi
+	if ! awk '
+		/^[[:space:]]*(#|$)/ { next }
+		{ c = $1; sub(/\r$/, "", c) }
+		c ~ /^[0-9a-fA-F:.]+\/[0-9]+$/ { printf "%s\"%s\"", (n++ ? "," : "{\"version\":2,\"rules\":[{\"ip_cidr\":["), c }
+		END { if (!n) exit 1; printf "]}]}\n" }
+	' "$src" > "$TMP_DIR/geoip_cn.json" ||
+	   ! "$SING_BOX" rule-set compile -o "$TMP_DIR/geoip_cn.srs" "$TMP_DIR/geoip_cn.json" >>"$LOG_PATH" 2>&1 ||
+	   ! validate_rule_set "$TMP_DIR/geoip_cn.srs"; then
+		log "[geoip_cn] Update failed while building the rule-set."
+		return 1
+	fi
+	if ! install_resource "$TMP_DIR/geoip_cn.srs" "$new_hash" "geoip_cn" "srs"; then
+		log "[geoip_cn] Update failed while installing."
+		return 1
+	fi
+	log "[geoip_cn] Successfully updated."
+}
