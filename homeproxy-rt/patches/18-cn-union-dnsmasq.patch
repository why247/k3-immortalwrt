+# dnsmasq in front of sing-box (127.0.0.1#5333):
+#  - edns-packet-max 512: at 1232 sing-box relays the upstream answer with its
+#    authority/additional sections; dnsmasq then truncates it (TC) for clients
+#    without EDNS, whose first lookup of every domain came back empty. At 512
+#    sing-box trims the reply itself and the first answer is complete.
+#  - no min-cache-ttl / use-stale-cache: mainland CDN answers have short TTLs;
+#    pinning them for an hour keeps clients on overloaded or wrong nodes.
+if uci -q get dhcp.@dnsmasq[0] >/dev/null; then
+	uci -q batch <<-EOF >/dev/null
+		set dhcp.@dnsmasq[0].ednspacket_max='512'
+		delete dhcp.@dnsmasq[0].min_cache_ttl
+		delete dhcp.@dnsmasq[0].use_stale_cache
+		commit dhcp
+	EOF
+fi
+
