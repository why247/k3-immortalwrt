--- a/root/etc/uci-defaults/luci-homeproxy
+++ b/root/etc/uci-defaults/luci-homeproxy
@@ -10,6 +10,12 @@
 	set firewall.homeproxy_client.path="/var/run/homeproxy/fw4_client.nft"
 	commit firewall
 fi
+
+# 首次启动下载CN IP列表（nftables绕过用），否则hp_cn4/hp_cn6为空
+if [ ! -f /etc/homeproxy/resources/cn_ip.list ]; then
+	/etc/homeproxy/scripts/update_resources.sh cn_ip >/dev/null 2>&1 || true
+	fw4 reload >/dev/null 2>&1 || true
+fi
+
 exit 0
