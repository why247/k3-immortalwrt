+# P1-1: Prevent concurrent runs (cron every 5min + slow download = overlap).
+# flock(1) is a dependency; use non-blocking lock.
+LOCK_FILE="$RUN_DIR/update_resources.lock"
+exec 9>"$LOCK_FILE"
+if ! flock -n 9; then
+	log "[RESOURCES] Another update is running; skipping."
+	exit 0
+fi
