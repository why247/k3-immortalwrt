+validate_cidr_list() {
+	local file="$1"
+	[ -s "$file" ] || return 1
+	# At least one CIDR with a sane prefix length must exist; this only
+	# rules out error pages / truncated downloads. Individual bad lines
+	# are skipped with a warning by firewall_pre.uc (load_cidr_file) and
+	# must NOT fail the whole update -- a single bad upstream line would
+	# otherwise wedge automatic updates forever (fail-closed but stalled).
+	awk '
+		/^[[:space:]]*(#|$)/ { next }
+		{
+			line=$0
+			sub(/^[[:space:]]+/, "", line)
+			sub(/[[:space:]]+$/, "", line)
+			n=split(line, p, "/")
+			if (n != 2) next
+			addr=p[1]; plen=p[2]
+			if (plen !~ /^[0-9]+$/) next
+			if (index(addr, ":") > 0) {
+				if (plen+0 <= 128) { ok=1; exit }
+			} else {
+				if (plen+0 <= 32) { ok=1; exit }
+			}
+		}
+		END { exit !ok }
+	' "$file"
 }
 
