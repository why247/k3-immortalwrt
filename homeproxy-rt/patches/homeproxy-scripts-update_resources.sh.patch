+# Backup current cn_ip data BEFORE attempting update, so a failed
+# firewall refresh can restore the previous working data atomically.
+cn_ip_list="$RESOURCES_DIR/cn_ip.list"
+cn_ip_ver="$RESOURCES_DIR/cn_ip.ver"
+cn_ip_list_bak="$RESOURCES_DIR/cn_ip.list.bak"
+cn_ip_ver_bak="$RESOURCES_DIR/cn_ip.ver.bak"
+# P1-3: Verify backup integrity with cmp. If cp fails (disk full), the backup
+# would be empty/corrupt and rollback would destroy good data. Abort early.
+[ -f "$cn_ip_list" ] && cp -f "$cn_ip_list" "$cn_ip_list_bak" && \
+	cmp -s "$cn_ip_list" "$cn_ip_list_bak" || { log "[RESOURCES] CRITICAL: cn_ip.list backup failed, aborting."; exit 1; }
