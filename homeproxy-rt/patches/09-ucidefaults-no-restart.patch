--- a/root/etc/uci-defaults/luci-homeproxy
+++ b/root/etc/uci-defaults/luci-homeproxy
@@ -30,7 +36,32 @@
 rm -rf /tmp/luci-*
 rm -f /etc/homeproxy/dashboard/.etag
 [ ! -d /etc/homeproxy/dashboard ] || chmod -R a+rX /etc/homeproxy/dashboard
-[ ! -f /var/run/homeproxy/sing-box-c.json ] || \
-	/etc/init.d/homeproxy restart >/dev/null 2>&1 || \
-	printf '%s\n' 'HomeProxy: failed to restart the running service after upgrade.' >&2
+# Regenerate firewall rules on upgrade so new bypass logic (e.g. DHCP
+# UDP 67/68 and DHCPv6 UDP 546/547) takes effect immediately. This
+# intentionally does NOT restart sing-box: a full service restart during
+# a LuCI package upgrade has been observed to disrupt ubus/LuCI.
+# Re-running firewall_pre.uc + fw4 reload is sufficient for firewall
+# changes and does not touch the running proxy.
+#
+# The regenerated include is validated with nft --check before reloading:
+# a broken include aborts the entire fw4 reload and would leave the
+# firewall (and the transparent proxy) down. On failure the previous
+# working include is restored (mirrors update_resources.sh logic).
+if [ -f /var/run/homeproxy/sing-box-c.json ]; then
+	client_nft=/var/run/homeproxy/fw4_client.nft
+	[ -f "$client_nft" ] && cp -f "$client_nft" "$client_nft.upgrade-bak"
+	if ucode /etc/homeproxy/scripts/firewall_pre.uc >/dev/null 2>&1 &&
+	   fw4 print 2>/dev/null | nft --check -f - >/dev/null 2>&1 &&
+	   fw4 reload >/dev/null 2>&1; then
+		rm -f "$client_nft.upgrade-bak"
+	else
+		printf '%s\n' 'HomeProxy: failed to refresh firewall rules after upgrade.' >&2
+		if [ -f "$client_nft.upgrade-bak" ]; then
+			cp -f "$client_nft.upgrade-bak" "$client_nft"
+			fw4 reload >/dev/null 2>&1 || \
+				printf '%s\n' 'HomeProxy: CRITICAL: failed to restore firewall rules after upgrade.' >&2
+			rm -f "$client_nft.upgrade-bak"
+		fi
+	fi
+fi
 exit 0
