# ---- 目标：只编 K3（以前符号写错，导致整个 bcm53xx 30+ 机型全编）----
CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_phicomm_k3=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_JFFS2 is not set

# luci
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y

# WiFi：2x BCM4366 (brcmfmac FullMAC) + K3 专用固件
CONFIG_PACKAGE_wpad-basic=y
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_brcmfmac-firmware-4366c0-pcie-k3=y
CONFIG_PACKAGE_iw=y

# 转发性能：fw4 软件流卸载 (bcm53xx 无硬件 NAT，这是唯一能大幅降 CPU 的手段)
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched=y

# HomeProxy redirect + TPROXY
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_ip-full=y

# ZRAM
# CONFIG_PACKAGE_zram-swap is not set
# CONFIG_PACKAGE_kmod-zram is not set

# IPv6
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# 工具
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
