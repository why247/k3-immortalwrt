#!/bin/sh /etc/rc.common
# 每次开机都生效的网卡调优（ethtool 设置重启即丢，所以放 init.d）
START=99

start() {
	for dev in eth0 eth1 eth2 wan lan1 lan2 lan3 br-lan; do
		[ -d /sys/class/net/$dev ] || continue
		# GRO 必须开：旧脚本写成 gro off，每个包单独过协议栈，CPU 成倍上涨
		ethtool -K $dev gro on gso on sg on rx on tx on 2>/dev/null
	done
	return 0
}
