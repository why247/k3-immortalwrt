diff --git a/root/etc/hotplug.d/iface/90-homeproxy-dns b/root/etc/hotplug.d/iface/90-homeproxy-dns
new file mode 100644
index 0000000..e8ba9c5
--- /dev/null
+++ b/root/etc/hotplug.d/iface/90-homeproxy-dns
@@ -0,0 +1,36 @@
+#!/bin/sh
+# HomeProxy reads WAN DNS once, when it builds its config.
+# Built before WAN has DNS (boot, PPPoE redial) it falls back
+# to 223.5.5.5 and stays there. On WAN ifup/ifupdate compare
+# the DNS the config used (RUN_DIR/wan_dns) with the live one
+# and reload on mismatch.
+
+[ "$INTERFACE" = "wan" ] || exit 0
+case "$ACTION" in
+ifup|ifupdate) ;;
+*) exit 0 ;;
+esac
+
+R="/var/run/homeproxy"
+L="/var/lock/homeproxy-dns"
+mkdir "$L" 2>/dev/null || exit 0
+
+(
+	trap 'rmdir "$L"' EXIT
+	# ~90s: wait for DNS and any concurrent start to finish
+	for i in 1 2 3 4 5 6 7 8 9; do
+		sleep 10
+		[ -s "$R/sing-box-c.json" ] || continue
+		[ -f "$R/wan_dns" ] || exit 0
+		cur="$(ifstatus wan | \
+			jsonfilter -e '@["dns-server"][0]')"
+		[ -n "$cur" ] || continue
+		old="$(cat "$R/wan_dns")"
+		[ "$cur" = "$old" ] && exit 0
+		echo "$(date '+%F %T') [DAEMON] WAN DNS $cur," \
+			"config had '$old', reloading." \
+			>> "$R/homeproxy.log"
+		/etc/init.d/homeproxy reload
+		exit 0
+	done
+) </dev/null >/dev/null 2>&1 &
