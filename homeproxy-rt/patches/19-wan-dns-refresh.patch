+ * RUN_DIR/wan_dns; hotplug.d/iface/90-homeproxy-dns reloads when the real
+ * WAN DNS differs, so the fallback never sticks. */
+const wan_dns_seen = wan_dns || '';
 if (!wan_dns)
 	wan_dns = (routing_mode === 'global') ? '9.9.9.9' : '223.5.5.5';
 
