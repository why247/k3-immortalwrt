 system('mkdir -p ' + RUN_DIR);
+writefile(RUN_DIR + '/wan_dns', wan_dns_seen);
 if (!writefile(RUN_DIR + '/sing-box-c.json.new', sprintf('%.J\n', removeBlankAttrs(config))))
